# Anthropic
ANTHROPIC_API_KEY=           # Claude API key from console.anthropic.com

# Kroger OAuth (from developer.kroger.com)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
KROGER_REDIRECT_URI=http://localhost:3000/auth/kroger/callback

# NextAuth
NEXTAUTH_SECRET=             # Generate with: openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000

# Kroger user tokens (optional, for cart operations via MCP server)
KROGER_USER_ACCESS_TOKEN=
KROGER_USER_REFRESH_TOKEN=

# Optional defaults
DEFAULT_CHAIN=HARRIS TEETER
DEFAULT_ZIP=

# ---------------------------------------------------------------------------
# Deployment (Azure)
# These values are set automatically in Azure App Service via Terraform and
# GitHub Actions. Only relevant for production — not needed for local dev.
# See docs/DEPLOYMENT.md for full setup instructions.
# ---------------------------------------------------------------------------
# KROGER_REDIRECT_URI=https://app-grocery-planner-prod.azurewebsites.net/auth/kroger/callback
# NEXTAUTH_URL=https://app-grocery-planner-prod.azurewebsites.net
